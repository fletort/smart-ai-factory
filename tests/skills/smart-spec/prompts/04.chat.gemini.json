[
  {
    "role": "user",
    "parts": [
      {
        "text": "# SYSTEM INSTRUCTIONS\n{{smart_spec_skill}}\n# ASSOCIATED USER MESSAGE\n{{user_message}}"
      }
    ]
  },
  {
    "role": "model",
    "parts": [
      {
        "functionCall": {
          "id": "call-1",
          "name": "read_file",
          "args": { "path": ".smart.ai/config.yml" }
        },
        "thoughtSignature": "skip_thought_signature_validator"
      }
    ]
  },
  {
    "role": "user",
    "parts": [
      {
        "functionResponse": {
          "id": "call-1",
          "name": "read_file",
          "response": {
            "result": "{{read_file_config_result}}"
          }
        }
      }
    ]
  },
  {
    "role": "model",
    "parts": [
      {
        "text": "{{ llm_spec_draft_msg }}"
      }
    ]
  },
  {
    "role": "user",
    "parts": [
      {
        "text": "{{ user_close_draft_msg }}"
      }
    ]
  },
  {
    "role": "model",
    "parts": [
      {
        "functionCall": {
          "id": "call-2",
          "name": "read_file",
          "args": { "path": "{{ template_file }}" }
        },
        "thoughtSignature": "skip_thought_signature_validator"
      },
      {
        "functionCall": {
          "id": "call-3",
          "name": "read_file",
          "args": { "path": "{{ index_file }}" }
        }
      }
    ]
  },
  {
    "role": "user",
    "parts": [
      {
        "functionResponse": {
          "id": "call-2",
          "name": "read_file",
          "response": {
            "result": "{{ read_file_template_file_content }}"
          }
        }
      },
      {
        "functionResponse": {
          "id": "call-3",
          "name": "read_file",
          "response": {
            "result": "{{ read_file_index_result }}"
          }
        }
      }
    ]
  }
]
