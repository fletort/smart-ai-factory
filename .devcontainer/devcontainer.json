// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/python
{
  "name": "Python 3",
  // Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
  "image": "mcr.microsoft.com/devcontainers/python:3-3.14-trixie",
  "features": {
    // node is required by claude-code feature
    "ghcr.io/devcontainers/features/node:2.1.0": {},
    // See: https://code.claude.com/docs/en/devcontainer
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {},
    // Installs Poetry in an isolated environment (via pipx).
    "ghcr.io/devcontainers-extra/features/poetry:2": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "Continue.continue",
        "yzhang.markdown-all-in-one",
        "esbenp.prettier-vscode",
        "redhat.vscode-yaml",
        "DavidAnson.vscode-markdownlint"
      ],
      "settings": {
        "remote.extensionKind": {
          "Continue.continue": ["workspace"]
        },
        "editor.formatOnSave": true,
        "[markdown]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode",
          "editor.codeActionsOnSave": {
            "source.fixAll.markdownlint": "explicit"
          }
        },
        "[yaml]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[json]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[jsonc]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        }
      }
    }
  },
  "mounts": [
    // persist authentication and settings across rebuilds
    //   see: https://code.claude.com/docs/en/devcontainer#persist-authentication-and-settings-across-rebuilds
    "source=claude-code-config-${devcontainerId},target=/home/vscode/.claude,type=volume"
  ],
  "containerEnv": {
    // Force Claude to write .claude.json inside the volume.
    //   see: https://code.claude.com/docs/en/devcontainer#persist-authentication-and-settings-across-rebuilds
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude"
  },
  // Pre-install project dependencies (Poetry itself is installed by the poetry feature).
  "postCreateCommand": "poetry install",
  // Keep dependencies in sync whenever the container (re)starts.
  "postStartCommand": "poetry install"
  // Use 'forwardPorts' to make a list of ports inside the container available locally.
  // "forwardPorts": [],
  // Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
  // "remoteUser": "root"
}
