// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/python
{
  "name": "Python 3",
  // Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
  "image": "mcr.microsoft.com/devcontainers/python:3-3.14-trixie",
  "features": {
    // node is required by claude-code feature
    "ghcr.io/devcontainers/features/node:2.1.0": {},
    // See: https://code.claude.com/docs/en/devcontainer
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "Continue.continue",
        "yzhang.markdown-all-in-one",
        "bierner.markdown-mermaid",
        "esbenp.prettier-vscode",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "remote.extensionKind": {
          "Continue.continue": ["workspace"]
        },
        "editor.formatOnSave": true,
        "[markdown]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode",
          "editor.codeActionsOnSave": {
            "source.fixAll.markdownlint": "explicit"
          }
        },
        "[yaml]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[json]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[jsonc]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        }
      }
    }
  },
  "mounts": [
    // persist authentication and settings across rebuilds
    //   see: https://code.claude.com/docs/en/devcontainer#persist-authentication-and-settings-across-rebuilds
    "source=claude-code-config-smart-ai,target=/home/vscode/.claude,type=volume"
  ],
  "containerEnv": {
    // Force Claude to write .claude.json inside the volume.
    //   see: https://code.claude.com/docs/en/devcontainer#persist-authentication-and-settings-across-rebuilds
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude"
  }
  // Features to add to the dev container. More info: https://containers.dev/features.
  // "features": {},
  // Use 'forwardPorts' to make a list of ports inside the container available locally.
  // "forwardPorts": [],
  // Use 'postCreateCommand' to run commands after the container is created.
  // "postCreateCommand": "pip3 install --user -r requirements.txt",
  // Configure tool-specific properties.
  // "customizations": {},
  // Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
  // "remoteUser": "root"
}
